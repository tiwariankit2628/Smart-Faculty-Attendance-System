# FastAPI Service Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Security & Inter-Service Authentication
# Must match FACE_SERVICE_API_KEY in the Node.js backend
FACE_SERVICE_API_KEY=internal_secret_face_service_key_7788

# Allowed Internal Origins (Node.js Backend & Internal Services)
ALLOWED_ORIGINS=["http://localhost:5000", "http://127.0.0.1:5000"]

# Facial Recognition & Verification Thresholds (Deep Learning SFace Model)
# Calibrated: Same person >= 0.70 (typical 0.85-0.99), Different person <= 0.45 (typical 0.05-0.42)
SIMILARITY_THRESHOLD=0.65
L2_DISTANCE_THRESHOLD=0.85

# Anti-Spoofing & Kinematic Liveness threshold (0.0 to 1.0)
LIVENESS_THRESHOLD=0.55

# Image Quality Gates
MIN_IMAGE_DIMENSION=150
MAX_IMAGE_SIZE_BYTES=10485760
BLUR_THRESHOLD=65.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=235.0

# Storage for Reference Embeddings
STORAGE_DIR=data/embeddings
